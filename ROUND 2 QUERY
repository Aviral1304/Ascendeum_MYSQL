SELECT
    substr(`date`, 9, 2) || '/' || substr(`date`, 6, 2) || '/' || substr(`date`, 3, 2)  AS att_date,
    resource_id,
    MIN(CASE WHEN is_clock_in  = 1 THEN start_time END)                AS clock_in_time,
    MAX(CASE WHEN is_clock_out = 1 THEN end_time END)                  AS clock_out_time,
    ROUND(
        SUM(
            CASE
                WHEN julianday(end_time) >= julianday(start_time)
                THEN (julianday(end_time) - julianday(start_time)) * 24
                ELSE 0
            END
        ), 2
    )                                                                   AS total_hours
FROM test_de
WHERE start_time IS NOT NULL
  AND end_time   IS NOT NULL
  AND end_time   != '2000-01-01 00:00:00'
  AND start_time != '2000-01-01 00:00:00'
  AND strftime('%Y', start_time) = strftime('%Y', `date`)
GROUP BY `date`, resource_id
HAVING MIN(CASE WHEN is_clock_in  = 1 THEN start_time END) IS NOT NULL
   AND MAX(CASE WHEN is_clock_out = 1 THEN end_time END)   IS NOT NULL
ORDER BY `date`, resource_id;
